# Copiar a .env (nunca subir .env al repositorio)
PORT=4000
HOST=0.0.0.0

# PostgreSQL (DB propia de POST, separada de Zabbix y Grafana)
DATABASE_URL=postgres://post_user:CAMBIAR@localhost:5432/post

# Zabbix (API de solo lectura). Token dedicado a POST.
# La ruta puede ser /api_jsonrpc.php o /zabbix/api_jsonrpc.php segun la instalacion.
ZABBIX_URL=https://LUNA.intranet.granjatresarroyos.com.ar/api_jsonrpc.php
ZABBIX_TOKEN=
# false = omitir validacion del certificado (solo para la conexion a Zabbix)
ZABBIX_VALIDATE_CERTS=false
ZABBIX_TIMEOUT_MS=15000
